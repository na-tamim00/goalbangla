# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Production Database & Cache
DATABASE_URL="postgresql://postgres:password@localhost:5432/goalbangla"
REDIS_URL="redis://localhost:6379"

# Media Storage (S3-compatible)
STORAGE_URL="https://storage.goalbangla.com"
STORAGE_ACCESS_KEY="minio_or_s3_key"
STORAGE_SECRET_KEY="minio_or_s3_secret"

# Football Data Provider API
FOOTBALL_API_KEY="optional_api_football_or_opta_key"
AUTH_SECRET="secret_jwt_and_session_signing_key_32_chars"
